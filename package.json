{
  "name": "monadflow",
  "version": "1.0.0",
  "description": "Monad 高吞吐/高并发 Agent 工作流上链系统",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "test:fork": "forge test --fork-url $MONAD_RPC_URL --match-path test/fork/",
    "test:coverage": "forge coverage --report lcov",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "lint": "eslint scripts/",
    "typecheck": "tsc --noEmit",
    "deploy:local": "source .env && forge script script/Deploy.s.sol:DeployMonadFlow --rpc-url http://localhost:8545 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --broadcast",
    "deploy:testnet": "source .env && forge script script/Deploy.s.sol:DeployMonadFlow --rpc-url $MONAD_RPC_URL --private-key $PRIVATE_KEY --broadcast --verify"
  },
  "dependencies": {
    "p-limit": "^6.1.0",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
